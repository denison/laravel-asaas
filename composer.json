{
  "name": "denison/asaas-package",
  "description": "Pacote simples de pagamento para Laravel usando o Asaas.",
  "type": "library",
  "require": {
    "php": "^7.4 || ^8.0",
    "illuminate/support": "^8.0 || ^9.0 || ^10.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "orchestra/testbench": "^6.0 || ^7.0 || ^8.0",
    "mockery/mockery": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "Denison\\AsaasPackage\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Denison\\AsaasPackage\\AsaasServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "license": "MIT"
}